# Environment Configuration Example
# Copy this file to .env and adjust the values for your deployment.

# Django Secret Key - generate a cryptographically strong secret for production
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Debug Mode (set to False in production)
DEBUG=False

# Allowed Hosts (comma-separated list of domains)
ALLOWED_HOSTS=abxar.pythonanywhere.com,localhost,127.0.0.1
